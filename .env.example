# Postgres connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# New projects issue a publishable key; older ones an anon key. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the store (used for payment redirect URLs). Optional —
# falls back to the incoming request's host.
# NEXT_PUBLIC_SITE_URL=https://your-store.com

# ============================================================
# Chargily Pay — online payment with EDAHABIA / CIB cards
# (https://dev.chargily.com)
# Paste your API key here when you get it (test_sk_... or live_sk_...).
# Until it is set, the checkout only offers cash on delivery.
# ============================================================
CHARGILY_API_KEY=
# Optional: dedicated webhook secret if you created one in the Chargily
# dashboard (Developers Corner). Defaults to CHARGILY_API_KEY.
CHARGILY_WEBHOOK_SECRET=
# Optional overrides:
# CHARGILY_PAYMENT_METHOD=edahabia   (edahabia | cib — customer can still switch on the payment page)
# CHARGILY_LOCALE=ar                 (ar | en | fr — language of the Chargily payment page)
# CHARGILY_API_URL=                  (only needed if Chargily changes its API base URL)
